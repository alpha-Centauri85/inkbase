# Copy to .env and fill in. Never commit .env - it holds live store credentials.

# --- Shopify (required) ---
# Full store domain, including .myshopify.com
SHOPIFY_STORE=your-store.myshopify.com

# OAuth credentials from your Shopify Dev Dashboard app settings
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin API access token. Leave blank initially: start the server, visit
# http://localhost:3000/auth and approve the app, and the callback will store it.
SHOPIFY_ADMIN_TOKEN=

# Optional, defaults shown
SHOPIFY_SCOPES=read_products,write_products
SHOPIFY_API_VERSION=2026-01

# --- Server ---
PORT=3000

# --- Google Books (optional) ---
# Without a key, ISBN lookups share Google's low-volume anonymous daily quota.
# Free key: https://console.cloud.google.com/ - enable "Books API", create an API Key.
GOOGLE_BOOKS_API_KEY=

# --- SerpApi (optional) ---
# Only needed for the price-comparison feature. https://serpapi.com/
SERPAPI_KEY=
